PORT=3000
EXCHANGE=binance
HISTORY_DAYS=90
QUOTE_CURRENCY=EUR
STARTING_BALANCE_EUR=100
TOP_N_PAIRS=20
DECISION_INTERVAL_MINUTES=15
# Conservative configurable estimate; use your actual account fee tier.
# Omit to select venue default (Binance 0.001 / legacy Kraken 0.008).
# TAKER_FEE_RATE=0.001
SIMULATED_LATENCY_MS_MIN=300
SIMULATED_LATENCY_MS_MAX=900
MAX_BOOK_AGE_MS=5000
MAX_ENTRY_SPREAD_BPS=20
MAX_ENTRY_SLIPPAGE_BPS=30
MAX_POSITION_PCT=0.30
MAX_TOTAL_RISK_PCT=0.025
MAX_OPEN_POSITIONS=4
MIN_ORDER_EUR=10
DEFAULT_STOP_LOSS_PCT=0.05
DEFAULT_TAKE_PROFIT_PCT=0.10
MAX_TRADES_PER_DAY=10
COIN_COOLDOWN_MINUTES=60
MAX_DRAWDOWN_PCT=0.25
AI_ENABLED=false
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_ALLOW_REMOTE=false
# Native local contract: API-reported identity pin and cloud-disabled metadata required.
AI_MODEL_MODE=ollama-local
AI_EXPECTED_MODEL_FINGERPRINT=
AI_CONTEXT_TOKENS=131072
AI_MAX_CONTEXT_CHARS=115000
AI_MAX_OUTPUT_TOKENS=1500
CONTEXT_EXTERNAL_ENABLED=true
# claude remains an inactive legacy provider; use openai-compatible for local HTTP models.
ANTHROPIC_API_KEY=
LOG_LEVEL=info
TZ_DISPLAY=Europe/Zurich
# Leave empty for a database isolated by exchange and quote currency.
DATABASE_PATH=

# Separate process only: pnpm live:cycle. Default NEVER submits private orders.
LIVE_ENABLED=false
LIVE_NETWORK=testnet
LIVE_ACK=
BINANCE_API_KEY=
BINANCE_API_SECRET=
LIVE_MAX_ORDER_QUOTE=10
LIVE_RISK_PER_TRADE_PCT=0.005
LIVE_MAX_DRAWDOWN_PCT=0.10
LIVE_FEE_RESERVE_PCT=0.005
LIVE_MAX_SPREAD_BPS=20
LIVE_MAX_SLIPPAGE_BPS=10

# Paper-only quality filter. No keys, subscriptions, remote execution or live orders.
QUALITY_PROFILE=normal
QUALITY_QUOTE=USDT
QUALITY_MIN_AGE_DAYS=90
QUALITY_MIN_QUOTE_VOLUME=5000000
QUALITY_MAX_SPREAD_BPS=25
QUALITY_DEPEG_BPS=50
QUALITY_SEVERE_DEPEG_BPS=200
QUALITY_STALE_HOURS=48
QUALITY_DELIST_HAIRCUT_PCT=10
QUALITY_DATA_DIR=data/coin-quality
# Free local backups only. Prefer an existing separate disk or USB drive.
# BACKUP_DIR=D:\TradingBackups
BACKUP_ENABLED=true
BACKUP_SCHEDULE=03:30
BACKUP_INCLUDE_ARCHIVE=false
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
