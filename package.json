{
  "name": "kraken-paper-bot",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @paper/shared build && pnpm --parallel --filter @paper/server --filter @paper/web dev",
    "build": "pnpm --filter @paper/shared build && pnpm --filter @paper/web build && pnpm --filter @paper/server build",
    "start": "node apps/server/dist/index.js",
    "test": "pnpm --filter @paper/shared build && pnpm --filter @paper/server build && pnpm --filter @paper/server test",
    "typecheck": "pnpm --filter @paper/shared build && pnpm --filter @paper/server typecheck && pnpm --filter @paper/web typecheck",
    "reset": "pnpm --filter @paper/server exec tsx src/reset.ts",
    "db:generate": "pnpm --filter @paper/server db:generate",
    "test:offline": "node --experimental-strip-types --test apps/server/test/research-offline.mjs apps/server/test/robustness-offline.mjs",
    "live:cycle": "pnpm --filter @paper/shared build && pnpm --filter @paper/server exec tsx src/live-cycle.ts",
    "research:report": "pnpm --filter @paper/shared build && pnpm --filter @paper/server exec tsx src/research-report.ts",
    "soak": "node scripts/soak.mjs",
    "live:run": "pnpm --filter @paper/shared build && pnpm --filter @paper/server build && node apps/server/dist/live-run.js",
    "research:portfolio": "pnpm --filter @paper/shared build && pnpm --filter @paper/server build && node apps/server/dist/portfolio-report.js",
    "verify": "pnpm typecheck && pnpm test && pnpm test:offline && pnpm test:trend-spike && pnpm build",
    "paper:test": "node scripts/start-paper-test.mjs",
    "paper:reconcile": "pnpm --filter @paper/server exec tsx src/broker/paper-reconcile-cli.ts",
    "data:import": "pnpm --filter @paper/server exec tsx src/archive/download.ts",
    "data:universe": "pnpm --filter @paper/server exec tsx src/archive/universe.ts",
    "data:report": "pnpm --filter @paper/server exec tsx src/archive/report.ts",
    "data:verify-source": "pnpm --filter @paper/server exec tsx src/archive/verify-source.ts",
    "backtest": "pnpm --filter @paper/server exec tsx src/backtest/cli.ts",
    "record:market": "pnpm --filter @paper/server exec tsx src/recorder/run.ts",
    "record:report": "pnpm --filter @paper/server exec tsx src/recorder/report.ts",
    "quality:check": "pnpm --filter @paper/server exec tsx src/coin-quality/cli.ts check",
    "quality:report": "pnpm --filter @paper/server exec tsx src/coin-quality/cli.ts report",
    "backup:run": "pnpm --filter @paper/server exec tsx src/backup/cli.ts run",
    "backup:list": "pnpm --filter @paper/server exec tsx src/backup/cli.ts list",
    "backup:verify": "pnpm --filter @paper/server exec tsx src/backup/cli.ts verify",
    "backup:restore": "pnpm --filter @paper/server exec tsx src/backup/cli.ts restore",
    "regime:report": "pnpm --filter @paper/server exec tsx src/regime/report.ts",
    "export:tax": "pnpm --filter @paper/server exec tsx src/tax/cli.ts",
    "pipeline:register": "pnpm --filter @paper/server exec tsx src/pipeline/cli.ts register",
    "pipeline:evaluate": "pnpm --filter @paper/server exec tsx src/pipeline/cli.ts evaluate",
    "pipeline:status": "pnpm --filter @paper/server exec tsx src/pipeline/cli.ts status",
    "dca:backtest": "pnpm --filter @paper/server exec tsx src/dca/cli.ts",
    "risk:reset": "pnpm --filter @paper/server exec tsx src/risk-engine/reset.ts",
    "risk:compare": "pnpm --filter @paper/server exec tsx src/risk-engine/compare.ts",
    "trend:spike": "pnpm --filter @paper/server exec tsx ../../scripts/spike/trend-1d-spike.mjs",
    "test:trend-spike": "node --test scripts/spike/trend-1d-spike.test.mjs",
    "pipeline:preflight": "pnpm --filter @paper/server exec tsx src/pipeline/cli.ts preflight",
    "pipeline:incidents": "pnpm --filter @paper/server exec tsx src/pipeline/cli.ts incidents",
    "pipeline:verify-integrity": "pnpm --filter @paper/server exec tsx src/pipeline/integrity-cli.ts",
    "cost:report": "pnpm --filter @paper/server exec tsx src/recorder/cost-report-cli.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
